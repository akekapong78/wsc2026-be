# wsc2026-be — copy to .env and fill in for local dev. Never commit .env.

# App
APP_ENV=development
PORT=8080

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=wsc2026
DB_PASSWORD=wsc2026
DB_NAME=wsc2026
DB_SSLMODE=disable

# goose migration (reads GOOSE_DRIVER / GOOSE_DBSTRING directly)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://wsc2026:wsc2026@localhost:5432/wsc2026?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations
