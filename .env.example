# wsc2026-be — copy to .env and fill in for local dev. Never commit .env.

# App
APP_ENV=development
PORT=8080

# Shared-secret guard on /api/v1/oms/... (X-API-Key header) — generate with:
#   openssl rand -hex 24
API_KEY=

# Postgres connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=wsc2026
DB_PASSWORD=wsc2026
DB_NAME=wsc2026
DB_SSLMODE=disable

# goose migration (reads GOOSE_DRIVER / GOOSE_DBSTRING directly)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://wsc2026:wsc2026@localhost:5432/wsc2026?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# Separate read-only lookup: PEA GIS meter database (gis_l table, ca_no ->
# lat/lon), used to fill in outage-report coordinates for the FE-osm map.
GIS_DBSTRING=
